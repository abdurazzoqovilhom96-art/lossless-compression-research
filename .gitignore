__pycache__/
*.pyc
.venv/
BDLC/downloads/**/*.zip
BDLC/downloads/**/*.tar.gz
BDLC/downloads/wheels-cp314-linux/
BDLC/data_B/DAVIS2017/*/
BDLC/data_C/COCO-Stuff/*/
regenerated_results/
# compressed streams, worker logs and task lists of the runs (not published here, see README.md);
# the I/O calibration tasks are part of its protocol and stay included
BDLC/runs/*/compressed/
BDLC/runs/*/compressed_timing/
BDLC/runs/*/streams/
BDLC/runs/*/logs/
BDLC/runs/*/tasks/
!BDLC/runs/20261030_175722_io_calibration/tasks/
# size-phase shards: every record is in raw_size/<codec>.json and verification/<codec>.json, the rest of each
# shard in raw_size/shards_meta.json (BDLC/posthoc/summarize_shards.py)
BDLC/runs/*/raw_size/shards/
BDLC/runs/*/verification/shards/
# output of paper_CEE/tools/make_paper_assets.py (the manuscript itself is not in this repository)
BDLC/paper_CEE/overleaf/
